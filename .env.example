# =============================================================================
# TwinCap — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# See AUDIT-AND-PLAN.md R14-E for rationale.
#
# REQUIRED in ALL environments:
# =============================================================================

# MongoDB connection string (Atlas shared tier, no multi-document transactions)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/twincap

# Session encryption secret (jose JWE A256GCM) — base64url-encoded 32-byte key
# Generate one with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AUTH_SECRET=<base64url-encoded-32-bytes>

# =============================================================================
# REQUIRED in production, OPTIONAL in development (R14-E):
# =============================================================================
# In production (NODE_ENV=production), failing to set these causes an immediate
# startup error — no silent fallback, no localhost links in emails.

# Transactional email via Resend (R13-B). In dev, if absent, reset/verify
# links are logged to the console instead of emailed.
RESEND_API_KEY=re_xxxxx

# Sender address for transactional emails (must be from a verified domain in Resend).
RESEND_FROM=TwinCap <no-reply@yourdomain.com>

# Public base URL used to build reset/verify and email verification links.
# MUST be the deployed URL in production — localhost generates broken links.
APP_BASE_URL=https://app.yourdomain.com

# =============================================================================
# OPTIONAL (opt-in features, safe to leave unset):
# =============================================================================

# Error monitoring (R13-D). Default off — set to "true" to activate.
# ERROR_MONITORING_ENABLED=true
# ERROR_ALERT_EMAIL=ops@example.com
# APP_RELEASE=v0.1.0

# User feedback emails (R13-E). When set, feedback submitted through the
# widget is forwarded to this address. Silent no-op if absent.
# FEEDBACK_EMAIL=feedback@example.com

# Product analytics (R13-G). Default off — set to "true" to activate.
# ANALYTICS_ENABLED=false
# Comma-separated email allowlist for the /analytics dashboard.
# ANALYTICS_ACCESS_EMAILS=founder@example.com
# Comma-separated emails excluded from global analytics aggregate.
# ANALYTICS_EXCLUDE_EMAILS=owner@example.com
